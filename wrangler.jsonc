{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bop-relay",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "REGISTRY", "class_name": "LobbyRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom", "LobbyRegistry"] }
  ]
}
